# EduTrace Pro — frontend environment
#
# Copy to `.env` for local development. Only EXPO_PUBLIC_* variables are readable by
# the app, and every one of them is embedded in the shipped binary in plain text.
#
# NEVER put secrets here: no signing keys, no database credentials, no Stitch API key,
# no privileged model endpoints. Anything sensitive belongs behind the backend.

# Set to "false" to route the app at a real REST API instead of the mock services.
# Defaults to mock (true) when unset.
EXPO_PUBLIC_USE_MOCK_API=true

# Base URL of the REST API. Ignored while USE_MOCK_API is true.
EXPO_PUBLIC_API_BASE_URL=https://api.edutrace.example/v1
