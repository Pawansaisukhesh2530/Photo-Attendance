EDUTRACE_ENV=development
EDUTRACE_DATABASE_URL=postgresql+psycopg://edutrace:edutrace@postgres:5432/edutrace
EDUTRACE_PGVECTOR_ENABLED=true
EDUTRACE_REDIS_URL=redis://redis:6379/0
EDUTRACE_QUEUE_BACKEND=celery
EDUTRACE_S3_ENDPOINT=http://minio:9000
EDUTRACE_S3_ACCESS_KEY=edutrace
EDUTRACE_S3_SECRET_KEY=change-this-secret
EDUTRACE_S3_BUCKET=edutrace-private
EDUTRACE_STORAGE_BACKEND=s3
EDUTRACE_JWT_SECRET=change-this-to-at-least-32-random-characters
EDUTRACE_DEFAULT_ACCOUNT_PASSWORD=LocalTest123!
EDUTRACE_MODEL_VERSION=insightface-buffalo-l-v3
EDUTRACE_RECOGNITION_BACKEND=insightface
EDUTRACE_INSIGHTFACE_ROOT=/models/insightface
EDUTRACE_INSIGHTFACE_MODEL_PACK=buffalo_l
EDUTRACE_INSIGHTFACE_DETECTION_CONFIDENCE=0.45
EDUTRACE_INSIGHTFACE_DETECTION_SIZE=1280
EDUTRACE_INSIGHTFACE_TILE_SIZE=1600
EDUTRACE_INSIGHTFACE_TILE_OVERLAP=0.25
EDUTRACE_INSIGHTFACE_TILE_TRIGGER_DIMENSION=1800
EDUTRACE_INSIGHTFACE_MAX_FACES_PER_IMAGE=250
EDUTRACE_MIN_ATTENDANCE_FACE_SIZE=32
EDUTRACE_MATCH_THRESHOLD=0.50
EDUTRACE_MIN_ENROLMENT_IMAGES=1
EDUTRACE_AMBIGUITY_MARGIN=0.05
EDUTRACE_MAX_ENROLMENT_SECONDARY_FACE_AREA_RATIO=0.10
EDUTRACE_ENROLMENT_DUPLICATE_FACE_OVERLAP_RATIO=0.50
EDUTRACE_MAX_ENROLMENT_EYE_SLOPE=0.35
EDUTRACE_MIN_ENROLMENT_EYE_DISTANCE_RATIO=0.20
