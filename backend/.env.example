EDUTRACE_ENV=development
EDUTRACE_DATABASE_URL=postgresql+psycopg://edutrace:edutrace@postgres:5432/edutrace
EDUTRACE_PGVECTOR_ENABLED=true
EDUTRACE_REDIS_URL=redis://redis:6379/0
EDUTRACE_QUEUE_BACKEND=celery
EDUTRACE_S3_ENDPOINT=http://minio:9000
EDUTRACE_S3_ACCESS_KEY=edutrace
EDUTRACE_S3_SECRET_KEY=change-this-secret
EDUTRACE_S3_BUCKET=edutrace-private
EDUTRACE_STORAGE_BACKEND=s3
EDUTRACE_JWT_SECRET=change-this-to-at-least-32-random-characters
EDUTRACE_MODEL_VERSION=unconfigured
EDUTRACE_DETECTOR_MODEL_PATH=/models/scrfd.onnx
EDUTRACE_EMBEDDER_MODEL_PATH=/models/arcface.onnx
EDUTRACE_RECOGNITION_BACKEND=auto
EDUTRACE_YUNET_MODEL_PATH=/models/face_detection_yunet.onnx
EDUTRACE_SFACE_MODEL_PATH=/models/face_recognition_sface.onnx
EDUTRACE_MATCH_THRESHOLD=0.45
EDUTRACE_AMBIGUITY_MARGIN=0.05
